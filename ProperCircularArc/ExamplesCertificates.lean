import ProperCircularArc.DeletionContraction

/-!
# Certificates for the worked examples

Generated by `scripts/generate_examples.py`. Each step is checked by Lean's kernel.
The right-hand sides are power-sum polynomials, later converted by Newton identities.
-/

namespace ProperCircularArc.Examples

open MvPolynomial Finset

noncomputable def p (N k : ℕ) : Pol N := psum (Fin N) ℚ k

set_option maxRecDepth 4096
set_option maxHeartbeats 2000000
private theorem cert_0 (N : ℕ) :
    weightedCSF N ![] ∅ =
      1 := by
  simp [weightedCSF]

private theorem cert_1 (N : ℕ) :
    weightedCSF N ![1] ∅ =
      p N 1 := by
  have he : (∅ : Finset (Fin 1 × Fin 1)) =
      (∅ : Finset (Fin 0 × Fin 0)).image
        (fun e => (e.1.castSucc, e.2.castSucc)) := by decide
  rw [he, weightedCSF_isolated]
  change p N 1 * weightedCSF N ![] ∅ = _
  rw [cert_0]
  all_goals ring

private theorem cert_2 (N : ℕ) :
    weightedCSF N ![1, 1] ∅ =
      p N 1 ^ 2 := by
  have he : (∅ : Finset (Fin 2 × Fin 2)) =
      (∅ : Finset (Fin 1 × Fin 1)).image
        (fun e => (e.1.castSucc, e.2.castSucc)) := by decide
  rw [he, weightedCSF_isolated]
  change p N 1 * weightedCSF N ![1] ∅ = _
  rw [cert_1]
  all_goals ring

private theorem cert_3 (N : ℕ) :
    weightedCSF N ![2] ∅ =
      p N 2 := by
  have he : (∅ : Finset (Fin 1 × Fin 1)) =
      (∅ : Finset (Fin 0 × Fin 0)).image
        (fun e => (e.1.castSucc, e.2.castSucc)) := by decide
  rw [he, weightedCSF_isolated]
  change p N 2 * weightedCSF N ![] ∅ = _
  rw [cert_0]
  all_goals ring

private theorem cert_4 (N : ℕ) :
    weightedCSF N ![1, 1] {(0, 1)} =
      p N 1 ^ 2 - p N 2 := by
  have he : ({(0, 1)} : Finset (Fin 2 × Fin 2)) =
      insert ((0 : Fin 1).castSucc, Fin.last 1) ∅ := by decide
  rw [he, weightedCSF_delete_contract]
  have hw : contractWeight (![1, 1] : Fin 2 → ℕ) 0 = ![2] := by decide
  have hc : contractEdges (∅ : Finset (Fin 2 × Fin 2)) 0 = ∅ := by decide
  rw [hw, hc, cert_2, cert_3]
  all_goals ring

private theorem cert_5 (N : ℕ) :
    weightedCSF N ![1, 1, 1] {(0, 1)} =
      p N 1 ^ 3 - p N 1 * p N 2 := by
  have he : ({(0, 1)} : Finset (Fin 3 × Fin 3)) =
      ({(0, 1)} : Finset (Fin 2 × Fin 2)).image
        (fun e => (e.1.castSucc, e.2.castSucc)) := by decide
  rw [he, weightedCSF_isolated]
  change p N 1 * weightedCSF N ![1, 1] {(0, 1)} = _
  rw [cert_4]
  all_goals ring

